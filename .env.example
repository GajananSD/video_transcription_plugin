# Copy to .env to change settings (all optional).
PLUGIN_NAME=Conversation Insights
TEAM_NAME=Your Team Name
PLUGIN_PORT=8300
# A word below this confidence counts as "unsure".
LOW_CONFIDENCE=0.30
UNSURE_MIN_WORDS=3
UNSURE_WINDOW_S=5
# One speaker above this share of talk time gets an "attention" flag.
DOMINANCE_SHARE=0.70
# Chart bucket size in seconds.
WINDOW_S=15
