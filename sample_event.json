  {
   "turn_id": "turn_001",
   "speaker": "SPEAKER_01",
   "start": 8.2,
   "end": 14.01,
   "text": "Sure. Um, so the solar project started two years ago when, uh, students proposed panels on the library roof.",
   "avg_confidence": 0.796
  },
  {
   "turn_id": "turn_002",
   "speaker": "SPEAKER_00",
   "start": 16.0,
   "end": 19.02,
   "text": "And how much energy does the library roof produce now?",
   "avg_confidence": 0.888
