  {
   "turn_id": "turn_003",
   "speaker": "SPEAKER_01",
   "start": 19.5,
   "end": 28.23,
   "text": "Right now the panels produce about forty percent of the library energy. Basically the solar panels, like, cover the whole roof and the inverters feed the campus grid.",
   "avg_confidence": 0.556
  },
  {
   "turn_id": "turn_004",
   "speaker": "SPEAKER_00",
   "start": 31.0,
   "end": 34.45,
   "text": "That is impressive. What were the biggest problems with the inverters?",
   "avg_confidence": 0.876
  },
  {
   "turn_id": "turn_005",
   "speaker": "SPEAKER_01",
   "start": 30.6,
   "end": 35.39,
   "text": "Honestly the inverters overheated in summer, so the team added cooling and new monitoring software.",
   "avg_confidence": 0.862
  },
  {
   "turn_id": "turn_006",
   "speaker": "SPEAKER_00",
   "start": 40.0,
   "end": 43.91,
